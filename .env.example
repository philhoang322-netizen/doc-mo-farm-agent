# Facebook Messenger — Omni Sale DMF
# Leave MESSENGER_ENABLED unset or false until the Page token is set on Railway.
# Do not commit real tokens. Copy these names into Railway → Variables.

MESSENGER_ENABLED=false
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
# Optional. Tried only after FB_APP_SECRET fails. Unset once the primary secret matches.
FB_APP_SECRET_ALT=
# Optional diagnostic. Meta signs with the App Secret, not this token. Unset after the check.
FB_CLIENT_TOKEN=
# Emergency only: 1 or true. Temporary 10-minute pipeline proof. Default off. Does not auto-send.
MESSENGER_SKIP_VERIFY=
# Temporary: 1 or true. Logs messenger_sig_capture (headers + raw body base64). Default off. No secrets. Unset after one message.
MESSENGER_SIG_CAPTURE=
